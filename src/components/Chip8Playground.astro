---
---
<section class="playground chip8-playground" data-chip8-root aria-labelledby="chip8-title">
  <div class="playground-heading">
    <div>
      <p class="eyebrow">INTERACTIVE PLAYGROUND</p>
      <h2 id="chip8-title">A CHIP-8 machine in your browser<span class="text-accent">.</span></h2>
      <p class="playground-lede">Run the built-in movement demo or load a CHIP-8 ROM. Use Q/E or the on-screen keypad to move.</p>
    </div>
    <span class="playground-chip">64 × 32 DISPLAY</span>
  </div>
  <div class="chip8-machine">
    <div class="chip8-screen-wrap">
      <div class="panel-topline"><span>DISPLAY / 01</span><span data-chip8-status role="status">READY</span></div>
      <canvas class="chip8-screen" data-chip8-screen width="64" height="32" aria-label="CHIP-8 display"></canvas>
      <div class="chip8-controls">
        <button class="demo-button demo-primary" type="button" data-chip8-run>Run</button>
        <button class="demo-button" type="button" data-chip8-step>Step</button>
        <button class="demo-button" type="button" data-chip8-reset>Reset demo</button>
        <label class="demo-button file-button">Load ROM<input data-chip8-file type="file" accept=".ch8,.rom,.bin,application/octet-stream" /></label>
      </div>
      <p class="chip8-help">Keyboard: 1 2 3 4 / Q W E R / A S D F / Z X C V map to CHIP-8 keys 0–F.</p>
    </div>
    <aside class="chip8-side">
      <div class="panel-topline"><span>HEX KEYPAD</span><span>16 KEYS</span></div>
      <div class="chip8-keypad" data-chip8-keypad>
        {["1","2","3","C","4","5","6","D","7","8","9","E","A","0","B","F"].map((key) => <button type="button" class="chip8-key" data-chip8-key={key} aria-label={`CHIP-8 key ${key}`}>{key}</button>)}
      </div>
      <div class="chip8-readout">
        <div><span>PROGRAM COUNTER</span><strong data-chip8-pc>0200</strong></div>
        <div><span>INSTRUCTIONS</span><strong data-chip8-cycles>000000</strong></div>
        <div><span>LOADED ROM</span><strong data-chip8-rom>BUILT-IN DEMO</strong></div>
      </div>
    </aside>
  </div>
</section>
<script>
  import "../scripts/chip8-playground.js";
</script>
<style>
  .playground { margin-top:72px; padding:30px; border:1px solid var(--line-strong); background:linear-gradient(145deg,rgba(17,25,19,.96),rgba(8,12,9,.98)); }
  .playground-heading { display:flex; justify-content:space-between; align-items:start; gap:24px; margin-bottom:26px; }
  .playground-heading .eyebrow { margin-bottom:10px; }
  .playground-heading h2 { font-size:clamp(25px,3vw,36px); letter-spacing:-.055em; margin:0 0 10px; }
  .playground-lede { color:var(--muted); font-size:12px; line-height:1.8; margin:0; }
  .playground-chip { flex:none; border:1px solid var(--line); color:var(--accent); padding:7px 9px; font:9px var(--mono); letter-spacing:.08em; }
  .chip8-machine { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(220px,.65fr); gap:14px; }
  .chip8-screen-wrap,.chip8-side { min-width:0; border:1px solid var(--line); background:rgba(5,8,6,.55); padding:16px; }
  .panel-topline { display:flex; justify-content:space-between; gap:12px; color:var(--accent); font:9px var(--mono); letter-spacing:.1em; }
  .chip8-screen { display:block; width:100%; height:auto; margin:14px 0; aspect-ratio:2/1; image-rendering:pixelated; background:#030704; border:1px solid rgba(141,255,176,.18); }
  .chip8-controls { display:flex; flex-wrap:wrap; gap:8px; }
  .demo-button { display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--line-strong); background:transparent; color:var(--text); padding:10px 12px; font:10px var(--mono); cursor:pointer; transition:border-color .2s,color .2s,background .2s; }
  .demo-button:hover { border-color:var(--accent); color:var(--accent); }
  .demo-primary { background:var(--accent); color:#08100b; border-color:var(--accent); font-weight:700; }
  .demo-primary:hover { background:#b0ffc6; color:#08100b; }
  .file-button input { display:none; }
  .chip8-help { color:var(--dim); font:9px/1.8 var(--mono); margin:12px 0 0; }
  .chip8-keypad { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:6px; margin-top:14px; }
  .chip8-key { aspect-ratio:1.25; border:1px solid var(--line); background:#0b110d; color:#b8c3bb; font:12px var(--mono); cursor:pointer; touch-action:none; }
  .chip8-key:hover,.chip8-key.is-pressed { border-color:var(--accent); color:#07100a; background:var(--accent); }
  .chip8-readout { display:grid; gap:0; margin-top:22px; border-top:1px solid var(--line); }
  .chip8-readout div { display:flex; justify-content:space-between; gap:8px; padding:11px 0; border-bottom:1px solid var(--line); }
  .chip8-readout span { color:var(--dim); font:8px var(--mono); }
  .chip8-readout strong { color:var(--muted); font:9px var(--mono); text-align:right; }
  @media(max-width:760px) { .playground{padding:20px 14px;margin-top:55px}.playground-heading{flex-direction:column}.chip8-machine{grid-template-columns:1fr} }
</style>
