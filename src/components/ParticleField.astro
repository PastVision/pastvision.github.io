<canvas class="particle-field" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".particle-field");
  const context = canvas?.getContext("2d");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && context) {
    let width = 0;
    let height = 0;
    let particles: { x: number; y: number; radius: number; speed: number; alpha: number }[] = [];
    let frame = 0;

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      width = window.innerWidth;
      height = Math.min(window.innerHeight, 900);
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      const count = Math.min(70, Math.floor(width / 18));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 1.4 + 0.35,
        speed: Math.random() * 0.22 + 0.04,
        alpha: Math.random() * 0.42 + 0.08
      }));
    };

    const draw = () => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      for (const particle of particles) {
        context.beginPath();
        context.fillStyle = `rgba(126, 255, 170, ${particle.alpha})`;
        context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
        context.fill();
        if (!reduceMotion) {
          particle.y -= particle.speed;
          if (particle.y < -4) {
            particle.y = height + 4;
            particle.x = Math.random() * width;
          }
        }
      }
      if (!reduceMotion) frame = requestAnimationFrame(draw);
    };

    resize();
    draw();
    window.addEventListener("resize", () => {
      cancelAnimationFrame(frame);
      resize();
      draw();
    }, { passive: true });
  }
</script>
